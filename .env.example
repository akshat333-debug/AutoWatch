# Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never import into client components
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Per-event summarization + daily digest (current LLM provider)
GEMINI_API_KEY=AQ....

# Legacy — only needed if reverting summaries to Anthropic (see lib/anthropic.ts)
ANTHROPIC_API_KEY=sk-ant-...

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

RESEND_API_KEY=re_...
# Sender for alert/digest emails. MUST be an address on a domain you've verified
# at resend.com/domains — otherwise Resend free tier only delivers to your own
# account email. Falls back to onboarding@resend.dev (testing-only) if unset.
RESEND_FROM_EMAIL=AutoWatch Alerts <alerts@yourdomain.com>

INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...
